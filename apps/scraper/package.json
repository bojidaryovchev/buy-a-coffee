    "zod": "^3.25.76",
    "@aws-sdk/client-secrets-manager": "^3.723.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^22.18.13",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "bin": {
    "catalog-sync": "./src/cli.ts"
  }
