{
  "name": "@catalog/scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "crawl:discovery": "tsx src/cli.ts discovery",
    "sync:catalog": "tsx src/cli.ts sync",
    "reference:export": "tsx src/cli.ts reference",
    "images:gc": "tsx src/cli.ts images:gc",
    "build:lambda": "node scripts/build-lambda.mjs"
  },
  "dependencies": {
    "@catalog/db": "workspace:*",
    "@catalog/scraper-core": "workspace:*",
    "@catalog/shared": "workspace:*",
