# GENERATED - edit env.schema.mjs, then run `npm run env:example`.
#
# Copy to .env and fill in. Nothing here is required for local development.
# Values marked [manifest] are committed and deployed from the manifest;
# set them here only to override locally.

# --- Required ---------------------------------------------------------------
# The catalog database written by the sync job. Read through server-only, so
# it never reaches the browser.
# e.g. postgres://catalog:catalog@localhost:5433/catalog
DATABASE_URL=

# Absolute site URL for canonicals, Open Graph, the sitemap and structured
# data.
NEXT_PUBLIC_SITE_URL=   # [manifest] https://buy-a-coffee.com

# Salts the hashed client fingerprint used by rate limiting. The raw IP is
# never stored.
#
# Rate limiting keeps working without it, so nothing tells you the fingerprint is predictable.
# e.g. openssl rand -hex 32
RATE_LIMIT_SALT=

# --- Images -----------------------------------------------------------------
# CDN base for mirrored product images. Required in production, which has no
# persistent disk.
#
# Also read at BUILD time to build images.remotePatterns, so a change needs a redeploy.
# Must match STORAGE_PUBLIC_BASE_URL on the scraper side.
NEXT_PUBLIC_IMAGE_BASE_URL=   # [manifest] https://j6xpmlta50zfdxeo.public.blob.vercel-storage.com

# Where the sync wrote images under STORAGE_DRIVER=local. Resolved from the
# app directory.
STORAGE_LOCAL_DIR=../../.storage

# --- Search engines ---------------------------------------------------------
# Google Search Console ownership token: the content="..." of the HTML-tag
# method. Printed as <meta name="google-site-verification"> only when set.
# e.g. abc123DEF456_the-content-of-the-meta-tag
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools ownership token. Printed as <meta name="msvalidate.01">
# only when set.
# e.g. 0123456789ABCDEF0123456789ABCDEF
BING_SITE_VERIFICATION=

# IndexNow key: served at /<key>.txt and sent with every URL submitted to
# api.indexnow.org (Bing, Yandex and others). Unset, nothing is served and
# nothing is submitted.
#
# The catalog sync runs on GitHub Actions and needs the same value there
# to submit changed product URLs (submitIndexNow in @catalog/shared/indexnow).
# e.g. openssl rand -hex 16
INDEXNOW_KEY=

# --- Admin ------------------------------------------------------------------
# Enables the admin panel. Unset means the panel is disabled, not defaulted.
ADMIN_PASSWORD=

# Signs the admin session cookie. Required in production, and distinct from
# ADMIN_PASSWORD so rotating one does not sign out or expose the other.
# e.g. openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Scheduled jobs ---------------------------------------------------------
# Authorises the scheduled routes under /api/cron/. Vercel sends it as a
# bearer token with each cron call; anything without it is refused.
# e.g. openssl rand -hex 32
CRON_SECRET=

# --- Email ------------------------------------------------------------------
# Sends order notifications, admin mailbox replies, inbound forwards and the
# newsletter.
# e.g. re_xxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=

# Sender override. Set it on staging so previews do not send as the live
# brand.
MAIL_FROM=

# Where order notifications land. Without it, notifications are disabled.
# e.g. someone@gmail.com
MAIL_TO=

# Verifies the email.received webhook, which forwards inbound mail to MAIL_TO.
# e.g. whsec_xxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=

# --- Newsletter -------------------------------------------------------------
# Optional. A Resend segment every newsletter subscriber is also added to, as
# a record in Resend of who joined. Neither the sync nor the send needs it.
#
# Also create the contact property bac_unsubscribe_url (type string)
# under Audience -> Properties. Prefixed: properties are account-wide,
# shared with the other three sites.
# e.g. 00000000-0000-0000-0000-000000000000
RESEND_NEWSLETTER_SEGMENT_ID=

# This site's Resend topic. The copy of the list in Resend carries opt-in and
# opt-out on it, for buy-a-coffee alone: the account is shared by four sites,
# so the contact's own unsubscribed flag is never written. The newsletter is
# sent to the database's list and does not depend on it.
#
# Create it with default subscription Opt-out (fixed once created), so a
# contact counts only once this site has opted it in, and visibility
# Private, so the other sites' subscribers do not see it on Resend's
# preference page.
# e.g. 00000000-0000-0000-0000-000000000000
RESEND_NEWSLETTER_TOPIC_ID=

# Verifies the contact webhook at /api/resend/contacts, which records opt-outs
# of this site's topic made in Resend, account-wide unsubscribes, and
# permanent bounces and complaints of the newsletter. Not
# RESEND_WEBHOOK_SECRET, which is the inbound-mail endpoint's.
#
# Resend dashboard -> Webhooks -> add
# https://buy-a-coffee.com/api/resend/contacts, subscribed to
# contact.updated, contact.topics.updated, contact.deleted,
# email.bounced and email.complained.
# e.g. whsec_xxxxxxxxxxxx
RESEND_CONTACTS_WEBHOOK_SECRET=

#   BLOB_READ_WRITE_TOKEN  (set by the platform)

# --- Optional ---------------------------------------------------------------
# Pool size per process. Defaults to 2 on Vercel and 10 elsewhere; set only to
# override.
#
# Each serverless instance is its own process with its own pool, so 10 becomes 10 x N.
# e.g. 2
DATABASE_POOL_MAX=

# robots.txt gate for hosts that announce no environment. Leave unset on
# Vercel.
# e.g. production
NEXT_PUBLIC_ENVIRONMENT=

# --- Platform ---------------------------------------------------------------
#   VERCEL_ENV  (set by the platform)

#   VERCEL  (set by the platform)

#   NODE_ENV  (set by the platform)
