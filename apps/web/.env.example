# ---------------------------------------------------------------------------
# Storefront configuration. Copy to .env.local and adjust.
# ---------------------------------------------------------------------------

# --- Required --------------------------------------------------------------
# The catalog database written by the sync job. Any standard PostgreSQL.
DATABASE_URL=postgres://catalog:catalog@localhost:5433/catalog

# Absolute site URL. Used for canonical tags, Open Graph, the sitemap and
# structured data, so it must be the real public URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# --- Images ----------------------------------------------------------------
# Public base URL of the object storage or CDN holding mirrored product images.
# Leave empty in development: images are then served from the local storage
# directory through the app's own /media route.
NEXT_PUBLIC_IMAGE_BASE_URL=
# Where the sync wrote images when STORAGE_DRIVER=local. Relative paths are
# resolved from the app directory.
STORAGE_LOCAL_DIR=../../.storage

# --- Branding --------------------------------------------------------------
# The shop sells only in Bulgaria: all customer-facing copy is Bulgarian and the
# locale is fixed to bg-BG. The brand name is deliberately kept in Latin script.
# Legal details below are still outstanding.
NEXT_PUBLIC_SITE_NAME=Buy a Coffee
NEXT_PUBLIC_SITE_SHORT_NAME=Buy a Coffee
NEXT_PUBLIC_SITE_TAGLINE=Кафе, подбрано с грижа
NEXT_PUBLIC_SITE_DESCRIPTION=Кафе на зърна, капсули и дози от марки, които си заслужават. Поръчка на една стъпка — ние ви звъним, за да потвърдим.
NEXT_PUBLIC_SITE_LOCALE=bg-BG
NEXT_PUBLIC_CURRENCY=EUR

# --- Contact ---------------------------------------------------------------
NEXT_PUBLIC_CONTACT_PHONE=+359 000 000 000
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_CONTACT_HOURS=Пон–Пет, 9:00–18:00

# --- Legal -----------------------------------------------------------------
# Deliberately empty. The footer and structured data omit company details
# entirely until these are real: publishing an invented registration number
# would be a legal problem, not a cosmetic one.
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_COMPANY_ID=
NEXT_PUBLIC_LEGAL_VAT_ID=
NEXT_PUBLIC_LEGAL_ADDRESS=

# --- Features --------------------------------------------------------------
NEXT_PUBLIC_FEATURE_NEWSLETTER=true
NEXT_PUBLIC_FEATURE_BLOG=true

# --- Runtime ---------------------------------------------------------------
# Salt for the hashed client fingerprint used by rate limiting. Set a real
# random value in production; the raw IP address is never stored.
RATE_LIMIT_SALT=
DATABASE_POOL_MAX=10
# Set to "production" only on the real deployment: any other value makes
# robots.txt disallow everything, which is what keeps staging out of Google.
NEXT_PUBLIC_ENVIRONMENT=development
