# GENERATED - edit env.schema.mjs, then run `npm run env:example`.
#
# Copy to .env and fill in. Nothing here is required for local development.
# Values marked [manifest] are committed and deployed from the manifest;
# set them here only to override locally.

# --- Required ---------------------------------------------------------------
# The catalog database written by the sync job. Read through server-only, so
# it never reaches the browser.
# e.g. postgres://catalog:catalog@localhost:5433/catalog
DATABASE_URL=

# Absolute site URL for canonicals, Open Graph, the sitemap and structured
# data.
# e.g. https://buy-a-coffee.example
NEXT_PUBLIC_SITE_URL=

# Salts the hashed client fingerprint used by rate limiting. The raw IP is
# never stored.
#
# Rate limiting keeps working without it, so nothing tells you the fingerprint is predictable.
# e.g. openssl rand -hex 32
RATE_LIMIT_SALT=

# --- Images -----------------------------------------------------------------
# CDN base for mirrored product images. Required on any host without a
# persistent disk.
#
# Also read at BUILD time to build images.remotePatterns, so a change needs a redeploy.
# Must match STORAGE_PUBLIC_BASE_URL on the scraper side.
# e.g. https://d111111abcdef8.cloudfront.net
NEXT_PUBLIC_IMAGE_BASE_URL=

# Where the sync wrote images under STORAGE_DRIVER=local. Resolved from the
# app directory.
STORAGE_LOCAL_DIR=../../.storage

# --- Admin ------------------------------------------------------------------
# Enables the admin panel. Unset means the panel is disabled, not defaulted.
ADMIN_PASSWORD=

# Signs the admin session cookie. Falls back to ADMIN_PASSWORD, coupling
# rotation to sign-out.
# e.g. openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Email ------------------------------------------------------------------
# Sends order notifications, admin mailbox replies and inbound forwards.
# e.g. re_xxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=

# Sender override. Set it on staging so previews do not send as the live
# brand.
MAIL_FROM=

# Where order notifications land. Without it, notifications are disabled.
# e.g. someone@gmail.com
MAIL_TO=

# Verifies the email.received webhook, which forwards inbound mail to MAIL_TO.
# e.g. whsec_xxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=

# --- Optional ---------------------------------------------------------------
# Pool size per process. Defaults to 2 on Vercel and 10 elsewhere; set only to
# override.
#
# Each serverless instance is its own process with its own pool, so 10 becomes 10 x N.
# e.g. 2
DATABASE_POOL_MAX=

# robots.txt gate for hosts that announce no environment. Leave unset on
# Vercel.
# e.g. production
NEXT_PUBLIC_ENVIRONMENT=

# --- Platform ---------------------------------------------------------------
#   VERCEL_ENV  (set by the platform)

#   VERCEL  (set by the platform)

#   NODE_ENV  (set by the platform)
