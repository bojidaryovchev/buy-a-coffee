{
  "name": "@catalog/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "brand:assets": "node scripts/brand-assets.mjs",
    "email:preview": "tsx --tsconfig scripts/tsconfig.email-preview.json scripts/email-preview.tsx",
    "env:check": "node scripts/env-check.mjs",
    "env:push": "node scripts/env-push.mjs",
    "env:example": "node scripts/env-example.mjs",
    "test": "vitest run --root ../.. --project web-unit",
    "test:integration": "vitest run --root ../.. --project web-integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "seed:reference": "tsx scripts/seed-reference.ts",
    "reference:coverage": "tsx scripts/reference-coverage.ts",
    "measure:budgets": "tsx scripts/measure-budgets.ts",
    "indexnow:submit": "tsx scripts/indexnow-submit.ts",
    "reference:coverage:write": "tsx scripts/reference-coverage.ts --write",
    "check:originality": "tsx scripts/check-originality.ts",
    "check:launch": "tsx scripts/check-launch.ts",
    "copy:apply": "tsx scripts/apply-product-copy.ts",
    "copy:todo": "tsx scripts/copy-todo.ts",
    "copy:compat": "tsx scripts/copy-compat.ts",
    "mail:prune-foreign": "tsx scripts/mail-prune-foreign.ts",
    "catalog:reslug": "tsx scripts/catalog-reslug.ts",
    "catalog:pack-size": "tsx scripts/catalog-pack-size.ts"
  },
  "dependencies": {
    "@catalog/db": "workspace:*",
    "@catalog/shared": "workspace:*",
    "@hookform/resolvers": "5.9.1",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.0.6",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "drizzle-orm": "^0.44.6",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "7.89.0",
    "resend": "^6.18.1",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.13",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
