# ---------------------------------------------------------------------------
# Catalog SYNC JOB (apps/scraper) — the crawler that fills the database.
# The STOREFRONT (apps/web) is configured separately, in
# apps/web/.env.example. They overlap only on `DATABASE_URL` and
# `STORAGE_LOCAL_DIR` — and the latter deliberately differs between them,
# because each resolves the path from its own directory.
#
# Copy to .env and adjust. Never commit .env — and never paste a real
# credential into this file. It is tracked by git, so a password written here
# is a password pushed.
# ---------------------------------------------------------------------------

# Any standard PostgreSQL instance: local Docker, Neon, RDS, Supabase, ...
# The default matches `docker compose up -d` in this repository.
DATABASE_URL=postgres://catalog:catalog@localhost:5433/catalog

# Production alternative: read the connection string from AWS Secrets Manager
# at cold start instead of putting it in an environment variable.
# DATABASE_URL_SECRET_ARN=arn:aws:secretsmanager:eu-central-1:123456789012:secret:kafezona-catalog-prod/database-url

# --- Source site -----------------------------------------------------------
SOURCE_KEY=kafezona
SOURCE_NAME=KafeZona
SOURCE_BASE_URL=https://www.kafezona.com/
SOURCE_CANONICAL_HOST=www.kafezona.com
SOURCE_HOST_ALIASES=kafezona.com

# --- Politeness ------------------------------------------------------------
# Defaults are gentle on purpose: the catalog is small and there is nothing to
# gain from crawling it aggressively.
CRAWL_CONCURRENCY=4
CRAWL_TIMEOUT_MS=15000
CRAWL_MAX_RETRIES=3
CRAWL_MIN_DELAY_MS=100
CRAWL_RETRY_BASE_DELAY_MS=500
CRAWL_RETRY_MAX_DELAY_MS=10000
CRAWL_MAX_BODY_BYTES=5242880
CRAWL_MAX_REDIRECTS=5
CRAWL_RESPECT_ROBOTS=true
CRAWL_USER_AGENT=KafeZonaCatalogSync/0.1 (+catalog synchronisation for an authorised reseller; contact: ops@example.com)

# --- Crawl bounds ----------------------------------------------------------
CRAWL_MAX_PAGES=2000
CRAWL_MAX_DEPTH=8

# --- Reconciliation --------------------------------------------------------
# Consecutive successful syncs a product must be absent from before removal.
SYNC_MISSING_THRESHOLD=3

# --- Mass-removal circuit breaker -----------------------------------------
# Fraction of active products that may disappear in one run before the diff is
# refused outright.
SYNC_BREAKER_MAX_DISAPPEARED_RATIO=0.2
SYNC_BREAKER_MIN_DISCOVERED_RATIO=0.75
SYNC_BREAKER_MIN_ABSOLUTE_PRODUCTS=10
SYNC_BREAKER_MIN_PARSER_CONFIDENCE=0.6

# --- Image mirroring -------------------------------------------------------
IMAGES_ENABLED=true
IMAGE_CONCURRENCY=4
IMAGE_MAX_BYTES=10485760
IMAGE_TIMEOUT_MS=20000
IMAGE_MIN_DELAY_MS=50

# --- Object storage --------------------------------------------------------
# `local` writes to disk so development needs no AWS account at all.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
# Public/CDN base URL used to build image URLs for the storefront.
STORAGE_PUBLIC_BASE_URL=
# STORAGE_DRIVER=s3 additionally requires:
# S3_BUCKET=
# AWS_REGION=eu-central-1
# S3_PREFIX=

# --- Diagnostics -----------------------------------------------------------
LOG_LEVEL=info
SNAPSHOTS_ENABLED=true
REFERENCE_DIR=reference
